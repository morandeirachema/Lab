# Shared settings for scripts/pve/*.sh. Sourced by bash on the Proxmox nodes.
# Put per-site changes in config/lab.local.env (git-ignored); it is sourced
# after this file, so anything set there wins.

# --- Home LAN --------------------------------------------------------------
# Placeholders: replace them with your real network before the first run.
LAN_CIDR="192.168.1.0/24"
LAN_GATEWAY="192.168.1.1"
LAN_DNS="192.168.1.1"

# --- Storage ---------------------------------------------------------------
LAB_STORAGE="local-zfs"           # VM disks (local-lvm if you installed on ext4/LVM)
LAB_OVA_DIR="/var/lib/vz/import"  # copy .ova files here on the node that imports them
LAB_WORK_DIR="/var/lib/vz/import/.work"

# --- SDN: lab segments shared by every node ---------------------------------
LAB_SDN_ZONE="lab"
LAB_SDN_TYPE="vlan"     # vlan  -> tagged on vmbr0; your switch must pass 802.1Q tags
                        # vxlan -> tunnelled between node IPs; works on any switch,
                        #          but guest MTU must be 1450 (see docs/02-network.md)
LAB_SDN_BRIDGE="vmbr0"  # uplink bridge for the vlan zone
LAB_VXLAN_MTU=1450
# vnet:tag:alias   (tag = VLAN ID for vlan zones, VNI for vxlan zones)
LAB_VNETS=(
  "pam:10:PAM lab"
  "devops:20:DevOps lab"
  "cyber:30:Cyber range - isolated"
)

# --- Lab gateway (LXC): DHCP/DNS for the lab nets, routing to the LAN ---------
LABGW_ID=110
LABGW_HOSTNAME="labgw"
LABGW_LAN_IP="192.168.1.20/24"   # static, outside your router's DHCP pool
LABGW_DOMAIN="lab.home.arpa"     # lab guests register as <name>.lab.home.arpa
LABGW_MGMT_CIDR="$LAN_CIDR"      # who may reach the lab nets through the gateway
LABGW_SNAT_FROM_LAN="no"         # yes = LAN traffic appears to come from the gateway,
                                 # for guests with a static IP and no default route
# vnet:gateway/prefix:dhcp_first,dhcp_last:internet(yes|no)
# The cyber vnet is deliberately absent: the gateway never routes it.
LABGW_NETS=(
  "pam:10.10.10.1/24:10.10.10.100,10.10.10.199:no"
)

# --- Import defaults ---------------------------------------------------------
LAB_DISK_BUS="sata"              # what VirtualBox guests already have drivers for
LAB_NIC_MODEL="e1000"            # VirtualBox's default Intel PRO/1000 emulation
LAB_IMPORT_SNAPSHOT="imported"   # snapshot taken right after each import
LAB_START_DELAY=20               # seconds between guests in lab-ctl.sh start

# {{ ansible_managed }}
apiVersion: 1

datasources:
  # Fixed UIDs: the provisioned alert rules and dashboards refer to them.
  - name: Prometheus
    uid: prometheus
    type: prometheus
    access: proxy
    url: http://localhost:9090
    isDefault: true
    jsonData:
      httpMethod: POST

  - name: Loki
    uid: loki
    type: loki
    access: proxy
    url: http://localhost:3100
    jsonData:
      maxLines: 1000

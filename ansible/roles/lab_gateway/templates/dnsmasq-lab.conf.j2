# {{ ansible_managed }}
# Source: config/lab.yml (gateway). Interfaces: eth0 = LAN, eth1.. = lab nets.
domain-needed
bogus-priv
no-resolv
server={{ lab.lan.dns }}
local=/{{ lab.gateway.domain }}/
domain={{ lab.gateway.domain }}
expand-hosts
dhcp-authoritative
bind-dynamic

{% if lab.observability is defined and lab.observability.enabled | default(false) %}
# The observability VM has a static address, so it gets a fixed record.
host-record={{ lab.observability.hostname }}.{{ lab.gateway.domain }},{{ hostvars['obs'].ansible_host }}

{% endif %}
# DNS for the home LAN (lab names), never DHCP there
interface=eth0
no-dhcp-interface=eth0
{% for net in lab.gateway.nets %}

# {{ net.vnet }}
interface=eth{{ loop.index }}
{% if net.dhcp | default([]) | length == 2 %}
dhcp-range=set:{{ net.vnet }},{{ net.dhcp[0] }},{{ net.dhcp[1] }},12h
{% if net.isolated | default(false) %}
# Isolated: an address and nothing more. An option with no value is not sent
# (dnsmasq(8)): no router, no DNS server. Names the guests claim stay out of
# the lab's DNS, which the LAN queries.
dhcp-option=tag:{{ net.vnet }},option:router
dhcp-option=tag:{{ net.vnet }},option:dns-server
dhcp-ignore-names=tag:{{ net.vnet }}
{% else %}
dhcp-option=tag:{{ net.vnet }},option:router,{{ net.address.split('/')[0] }}
dhcp-option=tag:{{ net.vnet }},option:dns-server,{{ net.address.split('/')[0] }}
{% endif %}
{% if lab.sdn.type == 'vxlan' %}
dhcp-option=tag:{{ net.vnet }},option:mtu,{{ lab.sdn.vxlan_mtu }}
{% endif %}
{% endif %}
{% endfor %}

# Virtual machine images never go in git — they live on the Proxmox nodes
*.ova
*.ovf
*.vmdk
*.vdi
*.vhd
*.vhdx
*.qcow2
*.img
*.iso
*.mf

# Unpacked OVAs and other disk images (scripts/ova-unpack.sh, scripts/kali-fetch.sh)
artifacts/

# Local overrides and secrets
*.vault_pass
.vault_pass*
.env
.env.*
*.pem
*.key
*_rsa
*_ed25519

# Ansible
*.retry
ansible/.ansible/

# The console UI's environment (uv sync --project tui)
tui/.venv/
__pycache__/
.pytest_cache/

# OpenTofu: state, plugins, local variables
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example

# OS / editor noise
.DS_Store
*.swp
.vscode/
.idea/
